{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_named}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "license": "GPL-3.0-only",
  "environment": "*",
  "entrypoints": {
    "main": [
      "nadiendev.osa.OptimizerSodiumAddon"
    ],
    "client": [
